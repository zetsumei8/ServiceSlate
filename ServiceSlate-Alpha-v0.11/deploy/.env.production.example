# Copy to deploy/.env and replace every CHANGE_ME value.
SERVICESLATE_DOMAIN=serviceslate.example.com
POSTGRES_DB=serviceslate
POSTGRES_USER=serviceslate
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
MINIO_ROOT_USER=serviceslate
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_STORAGE_PASSWORD
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SERVICESLATE_MASTER_KEY=CHANGE_ME_FERNET_KEY
SERVICESLATE_REQUIRE_UPLOAD_SCAN=1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICESLATE_SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Scheduled PostgreSQL backup target. Defaults can point at bundled MinIO; for true off-site backup use an external S3-compatible endpoint.
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_BUCKET=serviceslate
BACKUP_S3_ACCESS_KEY=serviceslate
BACKUP_S3_SECRET_KEY=CHANGE_ME_BACKUP_STORAGE_PASSWORD
BACKUP_RETENTION_DAYS=30
